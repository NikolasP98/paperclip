# paperclip-minion/.env.defaults — non-secret defaults, committed to git.
# Loaded by @minion-stack/env as layer 3 (subproject-defaults).
# Secrets belong in Infisical project minion-paperclip, NEVER here.

# Server defaults
PORT=3100
SERVE_UI=false

# Migration defaults
PAPERCLIP_MIGRATION_PROMPT=never
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# Telemetry defaults (opt-out by default in non-user deployments)
PAPERCLIP_TELEMETRY_DISABLED=false
DO_NOT_TRACK=0
