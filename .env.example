# paperclip-minion/.env.example — secret + runtime var NAMES expected. DO NOT commit values.
#
# 6-layer resolution (per @minion-stack/env):
#   1. AI/.env.defaults                 (meta-repo root, non-secret)
#   2. Infisical project minion-core    (shared secrets)
#   3. paperclip-minion/.env.defaults   (subproject non-secret)
#   4. Infisical project minion-paperclip  (subproject secrets — source of truth for this file)
#   5. paperclip-minion/.env.local      (developer override, gitignored)
#   6. shell process.env                (runtime override)
#
# Run `minion sync-env paperclip` from the meta-repo root to materialize layers 1-4 into .env.local.
# Run `minion doctor --project paperclip` to validate every name below resolves.

# --- Core server config ---
DATABASE_URL=
PORT=
HOST=
NODE_ENV=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_BASE_URL=
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Paperclip deployment + UI ---
SERVE_UI=
PAPERCLIP_PUBLIC_URL=
PAPERCLIP_LISTEN_HOST=
PAPERCLIP_LISTEN_PORT=
PAPERCLIP_DEPLOYMENT_MODE=
PAPERCLIP_DEPLOYMENT_EXPOSURE=
PAPERCLIP_AUTH_BASE_URL_MODE=
PAPERCLIP_AUTH_PUBLIC_BASE_URL=
PAPERCLIP_AUTH_DISABLE_SIGN_UP=
PAPERCLIP_API_URL=
PAPERCLIP_HOME=
PAPERCLIP_CONFIG=
PAPERCLIP_CONTEXT=
PAPERCLIP_INSTANCE_ID=
PAPERCLIP_UI_DEV_MIDDLEWARE=
PAPERCLIP_OPEN_ON_LISTEN=
PAPERCLIP_ENABLE_COMPANY_DELETION=

# --- Paperclip runtime knobs ---
PAPERCLIP_MIGRATION_PROMPT=
PAPERCLIP_MIGRATION_AUTO_APPLY=
PAPERCLIP_EMBEDDED_POSTGRES_VERBOSE=
PAPERCLIP_LOG_DIR=
PAPERCLIP_E2E_SKIP_LLM=

# --- Paperclip DB backup ---
PAPERCLIP_DB_BACKUP_ENABLED=
PAPERCLIP_DB_BACKUP_DIR=
PAPERCLIP_DB_BACKUP_INTERVAL_MINUTES=
PAPERCLIP_DB_BACKUP_RETENTION_DAYS=

# --- Paperclip storage ---
PAPERCLIP_STORAGE_PROVIDER=
PAPERCLIP_STORAGE_LOCAL_DIR=
PAPERCLIP_STORAGE_S3_BUCKET=
PAPERCLIP_STORAGE_S3_REGION=
PAPERCLIP_STORAGE_S3_ENDPOINT=
PAPERCLIP_STORAGE_S3_PREFIX=
PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=

# --- Paperclip secrets store (local-encrypted, NOT Infisical) ---
PAPERCLIP_SECRETS_PROVIDER=
PAPERCLIP_SECRETS_MASTER_KEY=
PAPERCLIP_SECRETS_MASTER_KEY_FILE=
PAPERCLIP_SECRETS_STRICT_MODE=

# --- Paperclip attachments + allowed hosts ---
PAPERCLIP_ATTACHMENT_MAX_BYTES=
PAPERCLIP_ALLOWED_ATTACHMENT_TYPES=
PAPERCLIP_ALLOWED_HOSTNAMES=

# --- Paperclip telemetry + feedback export ---
PAPERCLIP_TELEMETRY_DISABLED=
PAPERCLIP_TELEMETRY_ENDPOINT=
PAPERCLIP_TELEMETRY_BACKEND_URL=
PAPERCLIP_TELEMETRY_BACKEND_TOKEN=
PAPERCLIP_FEEDBACK_EXPORT_BACKEND_URL=
PAPERCLIP_FEEDBACK_EXPORT_BACKEND_TOKEN=
DO_NOT_TRACK=

# --- Paperclip agent JWT (agent ↔ server auth) ---
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_AGENT_JWT_ISSUER=
PAPERCLIP_AGENT_JWT_AUDIENCE=
PAPERCLIP_AGENT_JWT_TTL_SECONDS=

# --- Paperclip worktree + workspace ---
PAPERCLIP_IN_WORKTREE=
PAPERCLIP_WORKTREE_NAME=
