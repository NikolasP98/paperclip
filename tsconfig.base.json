{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@minion-stack/tsconfig/node.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "isolatedModules": true,

    // --- Transitional overrides (Phase 3 adoption) ---
    // The shared @minion-stack/tsconfig/base.json enables these strict flags.
    // Enabling them here surfaces 428 pre-existing warnings across 13 workspace packages
    // (see .planning/phases/03-adopt-foundation-in-subprojects/03-04-ISSUES.md for triage).
    // Scope-creep refactor — scheduled for Phase 8 (Polish). Do NOT re-enable without
    // a dedicated cleanup plan.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false
  }
}
